<view class="view"><block wx:if="{{a}}"><view class="section-label">选择一个场景，点句子就能听</view><view class="scene-grid"><view wx:for="{{b}}" wx:for-item="d" wx:key="d" class="scene" hover-class="scene-hover" bindtap="{{d.e}}"><text class="s-emoji">{{d.a}}</text><view class="scene-txt"><text class="s-h4">{{d.b}}</text><text class="s-p">{{d.c}}</text></view></view></view></block><block wx:else><view class="section-label"><text>{{c}} {{d}} · 点句子听发音</text></view><view class="dialogue"><view wx:for="{{e}}" wx:for-item="l" wx:key="f" class="line"><text class="{{['who', l.b && 'b']}}">{{l.a}}</text><view class="bubble-text" hover-class="bt-hover" bindtap="{{l.e}}"><text class="en">{{l.c}}</text><text class="zh">{{l.d}}</text><text class="play">点我听一听</text></view></view></view><view class="controls" style="justify-content:center"><view class="btn primary" hover-class="btn-hover" bindtap="{{f}}">一句句读给我听</view></view></block></view>