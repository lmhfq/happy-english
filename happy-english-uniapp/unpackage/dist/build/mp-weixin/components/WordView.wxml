<view class="view word-view"><view class="tabs"><view wx:for="{{a}}" wx:for-item="g" wx:key="b" class="{{['chip', g.c && 'sel']}}" hover-class="chip-hover" bindtap="{{g.d}}">{{g.a}}</view></view><view class="tabs"><view wx:for="{{b}}" wx:for-item="t" wx:key="b" class="{{['chip', t.c && 'sel']}}" hover-class="chip-hover" bindtap="{{t.d}}">{{t.a}}</view></view><view class="tabs unit-row"><view wx:for="{{c}}" wx:for-item="u" wx:key="b" class="{{['chip', u.c && 'sel']}}" hover-class="chip-hover" bindtap="{{u.d}}">{{u.a}}</view></view><view wx:if="{{d}}" class="flash"><view class="prog-tag left">已认识 <text class="b">{{e}}</text></view><view class="prog-right"><view class="icon-btn" hover-class="ib-hover" bindtap="{{g}}"><image class="ico" src="{{f}}" mode="aspectFit"/></view><view class="prog-tag right">共 {{h}} 个</view></view><view class="flash-main"><text class="{{['pic', j && 'alt']}}">{{i}}</text><text class="word" bindtap="{{l}}">{{k}}</text><text class="zh">{{m}}</text><view class="speak" hover-class="speak-hover" bindtap="{{o}}"><image class="horn-ico" src="{{n}}" mode="aspectFit"/></view></view><view class="word-actions"><view class="btn" hover-class="btn-hover" bindtap="{{p}}">上一个</view><view class="btn green" hover-class="btn-hover" bindtap="{{q}}">我认识啦</view><view class="btn" hover-class="btn-hover" bindtap="{{r}}">下一个</view></view></view></view>